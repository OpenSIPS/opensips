ARG UBUNTU_VERSION=22.04
FROM ubuntu:${UBUNTU_VERSION}

ARG UBUNTU_VERSION
ARG COMPILER_PACKAGES

ENV DEBIAN_FRONTEND=noninteractive

COPY scripts/build /tmp/opensips-build

RUN set -eux; \
    COMPILER=gcc \
      BUILD_OS="ubuntu:${UBUNTU_VERSION}" \
      CI_COMPILER_PACKAGES="${COMPILER_PACKAGES} ca-certificates ccache docker.io git gnupg2 lsb-release wget" \
      sh -x /tmp/opensips-build/install_depends.sh; \
    rm -rf /var/lib/apt/lists/* /tmp/opensips-build
